    readFile(options: NativeKitReadFileOptions): Promise<NativeKitReadFileResult>;
    writeFile(options: NativeKitWriteFileOptions): Promise<NativeKitWriteFileResult>;
    appendFile(options: NativeKitWriteFileOptions): Promise<void>;
    deleteFile(options: NativeKitFilesystemOptions): Promise<void>;
