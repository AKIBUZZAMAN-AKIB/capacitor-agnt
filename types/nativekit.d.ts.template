    rmdir(options: NativeKitFilesystemOptions & { recursive?: boolean }): Promise<void>;
    readdir(options: NativeKitFilesystemOptions): Promise<{ files: NativeKitFileInfo[] }>;
    stat(options: NativeKitFilesystemOptions): Promise<NativeKitStatResult>;
    getUri(options: NativeKitFilesystemOptions): Promise<{ uri: string }>;
  };
  transfer: {
    download(options: NativeKitDownloadOptions): Promise<NativeKitDownloadResult>;
    upload(options: NativeKitUploadOptions): Promise<NativeKitUploadResult>;
  };
  browser: { open(input: string | { url: string }): Promise<void | { opened: true }> };
  share: {
    canShare(): Promise<{ value: boolean }>;
    show(options: { title?: string; text?: string; url?: string; files?: string[]; dialogTitle?: string }): Promise<{ activityType?: string }>;
  };
  network: {
    status(): Promise<NativeKitNetworkStatus>;
