    onFloatingMessage(callback: (event: { data: unknown } | Record<string, unknown>) => void): Promise<NativeKitRemoveHandle>;
  };
  appBrowser: NativeKitAppBrowserHostAPI;
}

/* Installed-package façade: no plugin object is exposed. Every operation is brokered. */
interface NativeKitInstalledIdentity { readonly id: string; readonly name: string; readonly version: string }
interface NativeKitInstalledSubscription extends NativeKitRemoveHandle { id: string }
interface NativeKitInstalledCapabilities {
  appEnabled: boolean;
  grants: Record<string, boolean>;
  methodOverrides: Record<string, boolean>;
  capabilityDecisions: Record<NativeKitAppBrowserCapability, NativeKitPermissionDecision>;
  methodDecisions: Record<string, NativeKitPermissionDecision>;
  allowedHosts: string[];
}
type NativeKitInstalledEventName =
  | 'location.watch' | 'http.stream' | 'network.change' | 'app.stateChange'
  | 'backgroundLocation.location' | 'alarms.fired' | 'notifications.received'
  | 'notifications.action' | 'push.received' | 'push.action';
interface NativeKitInstalledFilesystemOptions { path: string; directory?: 'Data' | 'Cache' }
interface NativeKitInstalledHttpOptions extends Omit<NativeKitHttpOptions, 'responseType' | 'webFetchExtra' | 'disableRedirects' | 'shouldEncodeUrlParams' | 'connectTimeout' | 'readTimeout' | 'dataType'> {
  responseType?: 'json' | 'text';
}
interface NativeKitInstalledStreamOptions extends Omit<NativeKitStreamOptions, 'method' | 'disableRedirects'> { method?: 'GET' | 'POST' }
interface NativeKitInstalledCameraOptions {
  quality?: number;
  width?: number;
  height?: number;
  allowEditing?: boolean;
  source?: 'PROMPT' | 'CAMERA' | 'PHOTOS';
}
interface NativeKitInstalledPhoto { data: string; encoding: 'base64'; format: string; saved: boolean }
interface NativeKitInstalledPickedImage { data: string; encoding: 'base64'; format: string }
interface NativeKitInstalledPickImagesResult { photos: NativeKitInstalledPickedImage[] }
interface NativeKitInstalledPositionOptions { enableHighAccuracy?: boolean; timeout?: number; maximumAge?: number }
interface NativeKitInstalledBackgroundLocationStatus { running: boolean; permission: NativeKitPermissionState; ownedByApp: boolean }
interface NativeKitInstalledAlarmCapabilities { exact: boolean; fullScreen: boolean; alarmKit: boolean }
interface NativeKitInstalledSqliteChanges { changes: { changes: number; lastId?: number } }
interface NativeKitInstalledFileInfo { name: string; type: 'file' | 'directory'; size: number; ctime?: number; mtime?: number }
interface NativeKitInstalledStatResult { type: 'file' | 'directory'; size: number; ctime?: number; mtime?: number }
interface NativeKitInstalledNotificationSchedule {
  at?: Date | string | number;
  every?: 'year' | 'month' | 'two-weeks' | 'week' | 'day' | 'hour' | 'minute';
  on?: Partial<Record<'year' | 'month' | 'day' | 'weekday' | 'hour' | 'minute' | 'second', number>>;
  count?: number;
  allowWhileIdle?: boolean;
}
interface NativeKitInstalledNotification {
  id: string | number;
  title: string;
  body: string;
  schedule?: NativeKitInstalledNotificationSchedule;
  sound?: 'default';
}
interface NativeKitInstalledNotificationEventSchedule {
  at?: string;
  every?: 'year' | 'month' | 'two-weeks' | 'week' | 'day' | 'hour' | 'minute';
  repeats?: boolean;
  on?: Partial<Record<'year' | 'month' | 'day' | 'weekday' | 'hour' | 'minute' | 'second', number>>;
  count?: number;
  allowWhileIdle?: boolean;
}
interface NativeKitInstalledAlarmOptions {
  id: string;
  title: string;
  body: string;
  at: Date | string | number;
  repeatIntervalMinutes?: number;
  fullScreen?: boolean;
  sound?: 'default';
}
interface NativeKitInstalledAlarmRecord {
  id: string;
  title: string;
  body: string;
  scheduledAt: number;
  repeatIntervalMinutes: number;
}
interface NativeKitInstalledPermissionSnapshot {
  camera: Partial<Record<'camera' | 'photos', NativeKitPermissionState>>;
  location: Partial<Record<'location' | 'coarseLocation', NativeKitPermissionState>>;
  notifications: Partial<Record<'display', NativeKitPermissionState>>;
  push: Partial<Record<'receive', NativeKitPermissionState>>;
  alarms: NativeKitInstalledAlarmCapabilities;
  backgroundLocation: NativeKitInstalledBackgroundLocationStatus;
}
interface NativeKitInstalledDownloadResult { path: string; bytes: number }
interface NativeKitInstalledBrowserResult { opened: true }
interface NativeKitInstalledShareResult { completed: boolean; activityType?: string }
interface NativeKitInstalledAppInfo { id: string; name: string; version: string }
interface NativeKitInstalledError { message: string; code?: string }
interface NativeKitInstalledStreamMessage { data: string; event?: string; id?: string; format: 'sse' | 'text' | 'ndjson' }
interface NativeKitInstalledStreamHandlers {
  onMessage?(message: NativeKitInstalledStreamMessage): void;
  onError?(error: Error & NativeKitInstalledError): void;
  onEnd?(details: { status?: number }): void;
}
interface NativeKitInstalledStreamSession { id: string; close(): Promise<void> }
interface NativeKitInstalledNotificationEvent { id: string; title: string; body: string; schedule?: NativeKitInstalledNotificationEventSchedule }
interface NativeKitInstalledNotificationAction { actionId: string; inputValue?: string; notification: Omit<NativeKitInstalledNotificationEvent, 'schedule'> }
interface NativeKitInstalledEventMap {
  'location.watch': { position: NativeKitPosition | null; error?: NativeKitInstalledError };
  'http.stream':
    | { type: 'message'; payload: NativeKitInstalledStreamMessage }
    | { type: 'error'; payload: NativeKitInstalledError }
    | { type: 'end'; payload: { status?: number } };
  'network.change': NativeKitNetworkStatus;
  'app.stateChange': NativeKitAppState;
  'backgroundLocation.location': NativeKitBackgroundLocationPoint;
  'alarms.fired': { id: string };
  'notifications.received': NativeKitInstalledNotificationEvent;
  'notifications.action': NativeKitInstalledNotificationAction;
  'push.received': NativeKitPushNotification;
  'push.action': NativeKitPushAction;
}
interface NativeKitInstalledAPI {
  readonly version: 'app-browser-1.1.0' | string;
  readonly appIdentity: NativeKitInstalledIdentity;
  ready(): Promise<NativeKitInstalledAPI>;
  call<T = unknown>(method: string, ...args: unknown[]): Promise<T>;
  capabilities(): Promise<NativeKitInstalledCapabilities>;
  subscribe<K extends NativeKitInstalledEventName>(eventName: K, callback: (event: NativeKitInstalledEventMap[K]) => void, options?: Record<string, unknown>): Promise<NativeKitInstalledSubscription>;
  permissions: {
    check(): Promise<NativeKitInstalledPermissionSnapshot>;
    requestCamera(): Promise<Partial<Record<'camera' | 'photos', NativeKitPermissionState>>>;
    requestLocation(coarseOnly?: boolean): Promise<Partial<Record<'location' | 'coarseLocation', NativeKitPermissionState>>>;
    requestNotifications(): Promise<Partial<Record<'display', NativeKitPermissionState>>>;
    openAppSettings(): Promise<void>;
  };
  http: {
    request<T = unknown>(options: NativeKitInstalledHttpOptions): Promise<NativeKitHttpResponse<T>>;
    get<T = unknown>(url: string, options?: Omit<NativeKitInstalledHttpOptions, 'url' | 'method'>): Promise<NativeKitHttpResponse<T>>;
    post<T = unknown>(url: string, data?: unknown, options?: Omit<NativeKitInstalledHttpOptions, 'url' | 'method' | 'data'>): Promise<NativeKitHttpResponse<T>>;
    stream(options: NativeKitInstalledStreamOptions, handlers?: NativeKitInstalledStreamHandlers): Promise<NativeKitInstalledStreamSession>;
  };
  camera: {
    getPhoto(options?: NativeKitInstalledCameraOptions): Promise<NativeKitInstalledPhoto>;
    pickImages(options?: { quality?: number; width?: number; height?: number; limit?: number }): Promise<NativeKitInstalledPickImagesResult>;
  };
  location: {
    current(options?: NativeKitInstalledPositionOptions): Promise<NativeKitPosition>;
    watch(callback: (position: NativeKitPosition | null, error?: NativeKitInstalledError) => void, options?: NativeKitInstalledPositionOptions): Promise<NativeKitInstalledSubscription>;
  };
  backgroundLocation: {
    start(options?: { minTimeMs?: number; minDistanceM?: number; desiredAccuracy?: 'low' | 'high'; maxBuffer?: number }): Promise<NativeKitInstalledBackgroundLocationStatus>;
    stop(): Promise<void>;
    status(): Promise<NativeKitInstalledBackgroundLocationStatus>;
  };
  haptics: {
    impact(style?: 'LIGHT' | 'MEDIUM' | 'HEAVY'): Promise<void>;
    notification(type?: 'SUCCESS' | 'WARNING' | 'ERROR'): Promise<void>;
    vibrate(duration?: number): Promise<void>;
  };
  notifications: {
    check(): Promise<Partial<Record<'display', NativeKitPermissionState>>>;
    request(): Promise<Partial<Record<'display', NativeKitPermissionState>>>;
    schedule(notifications: NativeKitInstalledNotification[]): Promise<{ scheduled: true; ids: string[] }>;
    cancel(ids: Array<string | number>): Promise<void>;
  };
  alarms: {
    capabilities(): Promise<NativeKitInstalledAlarmCapabilities>;
    requestExactAccess(): Promise<NativeKitInstalledAlarmCapabilities>;
    requestFullScreenAccess(): Promise<NativeKitInstalledAlarmCapabilities>;
    schedule(options: NativeKitInstalledAlarmOptions): Promise<{ id: string; scheduled: true }>;
    cancel(id: string): Promise<void>;
    list(): Promise<{ alarms: NativeKitInstalledAlarmRecord[] }>;
    stop(id: string): Promise<void>;
  };
  background: {
    dispatch(): Promise<{ dispatched: true }>;
    runSyncNow(): Promise<{ dispatched: true }>;
    checkPermissions(): Promise<{ geolocation: NativeKitPermissionState; notifications: NativeKitPermissionState }>;
    requestPermissions(apis: Array<'geolocation' | 'notifications'>): Promise<{ geolocation: NativeKitPermissionState; notifications: NativeKitPermissionState }>;
  };
  preferences: {
    set(key: string, value: string): Promise<void>;
    get(key: string): Promise<string | null>;
    remove(key: string): Promise<void>;
    setJSON(key: string, value: unknown): Promise<void>;
    getJSON<T = unknown>(key: string): Promise<T | null>;
  };
  secureStorage: {
    set(key: string, value: string): Promise<void>;
    get(key: string): Promise<string | null>;
    remove(key: string): Promise<void>;
  };
  sqlite: {
    open(name: string): Promise<{ name: string; open: true; encrypted: false }>;
    execute(name: string, statements: string, transaction?: boolean): Promise<NativeKitInstalledSqliteChanges>;
    run(name: string, statement: string, values?: unknown[], transaction?: boolean): Promise<NativeKitInstalledSqliteChanges>;
    query<T extends Record<string, unknown> = Record<string, unknown>>(name: string, statement: string, values?: unknown[]): Promise<{ values: T[] }>;
    close(name: string): Promise<void>;
    delete(name: string): Promise<{ deleted: true }>;
  };
  filesystem: {
    readFile(options: NativeKitInstalledFilesystemOptions & { encoding?: NativeKitEncoding }): Promise<{ data: string }>;
    writeFile(options: NativeKitInstalledFilesystemOptions & { data: string; encoding?: NativeKitEncoding; recursive?: boolean }): Promise<{ path: string }>;
    appendFile(options: NativeKitInstalledFilesystemOptions & { data: string; encoding?: NativeKitEncoding }): Promise<void>;
    deleteFile(options: NativeKitInstalledFilesystemOptions): Promise<void>;
    mkdir(options: NativeKitInstalledFilesystemOptions & { recursive?: boolean }): Promise<void>;
    rmdir(options: NativeKitInstalledFilesystemOptions & { recursive?: boolean }): Promise<void>;
    readdir(options: NativeKitInstalledFilesystemOptions): Promise<{ files: NativeKitInstalledFileInfo[] }>;
    stat(options: NativeKitInstalledFilesystemOptions): Promise<NativeKitInstalledStatResult>;
  };
  transfer: {
    download(options: NativeKitInstalledFilesystemOptions & { url: string; headers?: Record<string, string> }): Promise<NativeKitInstalledDownloadResult>;
    upload(options: NativeKitInstalledFilesystemOptions & { url: string; headers?: Record<string, string>; method?: 'POST' | 'PUT' | 'PATCH'; mimeType?: string }): Promise<NativeKitUploadResult>;
  };
  browser: { open(input: string | { url: string }): Promise<NativeKitInstalledBrowserResult> };
  share: {
    canShare(): Promise<{ value: boolean }>;
    show(options: { title?: string; text?: string; url?: string; dialogTitle?: string }): Promise<NativeKitInstalledShareResult>;
  };
  network: { status(): Promise<NativeKitNetworkStatus> };
  app: { info(): Promise<NativeKitInstalledAppInfo>; state(): Promise<NativeKitAppState> };
}

