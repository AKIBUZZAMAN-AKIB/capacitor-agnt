{
  "name": "@nativekit/phonebuddy-agent",
  "version": "0.2.0",
  "description": "PhoneBuddy SDK (Apache-2.0) as a Capacitor plugin: on-device Rust agent engine with OS-level background wakes, surfaced messages and host-event handling for every Android ABI.",
  "main": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "dist/esm/",
    "android/src/main/",
    "android/build.gradle",
    "Package.swift",
    "android/consumer-rules.pro",
    "ios/Sources/",
    "native/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@capacitor/core": ">=7.0.0"
  },
  "devDependencies": {
    "@capacitor/core": "^7.0.0"
  },
  "capacitor": {
    "android": {
      "src": "android"
    },
    "ios": {
      "src": "ios"
    }
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "agent",
    "on-device",
    "background"
  ],
  "license": "MIT"
}
