<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Package visibility for the Custom Tabs resolution in openUrl: the default
         https handler and Custom Tabs providers must be queryable (API 30+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application>
        <activity
            android:name="dev.nativekit.custom.AlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />

        <service
            android:name="dev.nativekit.custom.AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />

        <service
            android:name="dev.nativekit.custom.LocationTrackingService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <receiver android:name="dev.nativekit.custom.AlarmReceiver" android:exported="false" />
        <receiver android:name="dev.nativekit.custom.AlarmActionReceiver" android:exported="false" />
        <receiver android:name="dev.nativekit.custom.LocationActionReceiver" android:exported="false" />

        <receiver
            android:name="dev.nativekit.custom.BootReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
