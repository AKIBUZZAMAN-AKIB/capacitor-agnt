<?xml version="1.0" encoding="utf-8"?>
<!-- Zero-length animation used for the host window while the isolated surface
     slides over it (open) or slides away (close): the host must simply stay
     put and fully visible underneath. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="0"
    android:fromAlpha="1.0"
    android:toAlpha="1.0" />
