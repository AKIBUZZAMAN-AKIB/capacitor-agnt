{
  "$schema": "./app.config.schema.json",
  "app": {
    "name": "NativeKit TestLab",
    "id": "dev.nativekit.shell",
    "versionName": "1.4.6-testlab",
    "versionCode": 21,
    "buildNumber": "21",
    "description": "A reusable, locally bundled Capacitor application shell",
    "defaultLanguage": "bn",
    "urlScheme": "nativekit"
  },
  "web": {
    "mode": "static",
    "staticDir": "www",
    "framework": {
      "workDir": "web-source",
      "buildCommand": "npm ci && npm run build",
      "outputDir": "dist"
    },
    "nativeStagingDir": ".nativekit/staged-www",
    "webOutputDir": "web-dist",
    "injectBridge": true,
    "serviceWorker": {
      "enabledForWebTarget": true,
      "cacheName": "nativekit-web-v1",
      "offlineFallback": "index.html"
    }
  },
  "network": {
    "nativeHttp": true,
    "patchFetch": true,
    "patchXMLHttpRequest": true,
    "allowCleartext": false,
    "allowedHostnames": [],
    "connectTimeoutMs": 30000,
    "readTimeoutMs": 120000
  },
  "features": {
    "camera": true,
    "location": true,
    "backgroundLocation": true,
    "haptics": true,
    "localNotifications": true,
    "pushNotificationsReady": true,
    "advancedAlarms": true,
    "backgroundRunner": true,
    "sqlite": true,
    "secureStorage": true,
    "filesystem": true,
    "fileTransfer": true,
    "sharing": true,
    "networkStatus": true,
    "nativeSSE": true,
    "appBrowser": true,
    "inAppBrowser": true,
    "preferences": true,
    "nearby": true,
    "widget": true,
    "agent": true
  },
  "permissions": {
    "camera": "ছবি বা ভিডিও সংযুক্ত করতে ক্যামেরা ব্যবহারের অনুমতি প্রয়োজন।",
    "photos": "নির্বাচিত ছবি সংযুক্ত ও সংরক্ষণ করতে ফটো লাইব্রেরির অনুমতি প্রয়োজন।",
    "locationWhenInUse": "নিকটবর্তী তথ্য ও অবস্থানভিত্তিক ফিচারের জন্য আপনার অবস্থান প্রয়োজন।",
    "locationAlways": "আপনার চালু করা অবস্থান ট্র্যাকিং সেশনটি ব্যাকগ্রাউন্ডেও চালাতে অবস্থান প্রয়োজন।",
    "notifications": "রিমাইন্ডার, অ্যালার্ম ও গুরুত্বপূর্ণ আপডেট দেখাতে নোটিফিকেশন প্রয়োজন।",
    "alarmKit": "আপনার নির্ধারিত অ্যালার্ম সময়মতো বাজাতে সিস্টেম অ্যালার্ম অনুমতি প্রয়োজন।"
  },
  "android": {
    "minSdk": 24,
    "targetSdk": 36,
    "compileSdk": 36,
    "exactAlarmPermissionMode": "schedule",
    "fullScreenAlarm": true,
    "backgroundLocationForegroundService": true,
    "alarmSoundName": "default",
    "notificationChannelId": "nativekit_general",
    "alarmChannelId": "nativekit_alarms"
  },
  "ios": {
    "deploymentTarget": "15.0",
    "teamId": "",
    "alarmKitOnIOS26": false,
    "backgroundFetch": true,
    "backgroundProcessing": true,
    "backgroundLocation": true,
    "pushCapabilityConfigured": false
  },
  "appBrowser": {
    "enabled": true,
    "maxApps": 20,
    "maxPackageBytes": 15728640,
    "maxFiles": 500,
    "auditLogLimit": 2000,
    "maxRequestsPerMinute": 120,
    "defaultCapabilities": [],
    "permissionPrompts": {
      "enabled": true,
      "requestTimeoutMs": 90000,
      "requestedCapabilityDefault": "ask",
      "unrequestedCapabilityDefault": "block"
    },
    "allowDirectWebNetwork": false,
    "urlMode": {
      "enabled": true,
      "allowedHosts": []
    },
    "renderer": "isolated",
    "isolated": {
      "enabled": true,
      "fallbackToIframe": true,
      "stageChunkBytes": 262144,
      "androidMinApi": 28,
      "hangTerminationDelayMs": 4000
    }
  },
  "backgroundRunner": {
    "label": "dev.nativekit.shell.background",
    "event": "nativekit.sync",
    "repeat": true,
    "intervalMinutes": 15,
    "autoStart": true,
    "taskIdentifier": "dev.nativekit.shell.background",
    "defaultSyncUrl": ""
  },
  "widget": {
    "enabled": true,
    "homeScreen": {
      "enabled": true,
      "updatePeriodMinutes": 30,
      "resizeEnabled": true,
      "kinds": [
        {
          "id": "nativekit-widget",
          "label": "NativeKit",
          "layout": "medium",
          "minWidthDp": 140,
          "minHeightDp": 140,
          "targetCellWidth": 2,
          "targetCellHeight": 2
        }
      ]
    },
    "floating": {
      "enabled": true,
      "title": "NativeKit",
      "page": "public/widgets/floating.html",
      "width": 240,
      "height": 220,
      "startOnLaunch": false
    }
  },
  "security": {
    "trustedLocalContentOnly": true,
    "allowNavigation": [],
    "contentSecurityPolicy": "default-src 'self' data: blob:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https: wss:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-src 'self' data: blob: https:; object-src 'none'; base-uri 'self'"
  }
}
