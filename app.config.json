{
  "$schema": "./app.config.schema.json",
  "app": {
    "name": "NativeKit TestLab",
    "id": "dev.nativekit.shell",
    "versionName": "1.4.35-power-harness",
    "versionCode": 34,
    "buildNumber": "32",
